checkpoints/*.pt
experiments/*/checkpoint_best.pt

# ── SLURM logs (generated at runtime) ────────────────────────────────────────
logs/*.log

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.ipynb_checkpoints/

